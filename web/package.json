{
  "name": "nostrism-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/assemble-dist.mjs",
    "icons": "node scripts/make-icons.mjs",
    "fonts:emoji": "node scripts/build-emoji-fonts.mjs",
    "preview": "wrangler pages dev dist --ip 127.0.0.1 --port 8788",
    "test": "vitest run",
    "test:functions": "vitest run -c vitest.functions.config.ts",
    "lint": "biome check .",
    "check": "biome check . && node scripts/check-i18n.mjs",
    "format": "biome format --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.functions.json --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@cloudflare/vitest-plugin": "^1.2.8",
    "@cloudflare/workers-types": "^5.20260926.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.1",
    "opentype.js": "^2.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "~4.1.11",
    "wrangler": "^4.141.0"
  },
  "dependencies": {
    "applesauce-common": "^6.2.0",
    "applesauce-content": "^6.2.0",
    "applesauce-core": "^6.2.0",
    "applesauce-loaders": "^6.2.0",
    "applesauce-react": "^6.0.0",
    "applesauce-relay": "^6.2.1",
    "applesauce-signers": "^6.2.2",
    "blurhash": "^2.0.5",
    "dexie": "^4.4.6",
    "emojibase-data": "^17.0.0",
    "nostr-tools": "~2.19",
    "react-router": "^8.4.0",
    "react-virtuoso": "^4.18.15",
    "uqr": "^0.1.3",
    "zustand": "^5.0.15"
  }
}
