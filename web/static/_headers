# CSP を含む基本のセキュリティヘッダー（#647。inline script を置かないので script-src は 'self' で足りる。
# style-src の 'unsafe-inline' は React の style 属性用）。LP（/ 、/about）も同じ CSP の下に置く。
# 注意: functions/[[path]].ts の SPA フォールバックが ASSETS.fetch() をそのまま返す限りは効くが、
# 取得し直した URL（常に "/"）に対して評価される。パス別のヘッダー（下の noindex 等）はその性質上
# 効かないことがあるため、X-Robots-Tag は functions/[[path]].ts 側でも元のパスを見て付けている。
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data: blob:; media-src https: blob:; font-src 'self'; connect-src 'self' wss: https:; worker-src 'self'; manifest-src 'self'; frame-src https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Cross-Origin-Opener-Policy: same-origin

# themes.html は docs の正本（内容は変えない）。配色計算の inline script が残っているため、
# このページだけ script-src に 'unsafe-inline' を足す（他は変えない）
/themes.html
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data: blob:; media-src https: blob:; font-src 'self'; connect-src 'self' wss: https:; worker-src 'self'; manifest-src 'self'; frame-src https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# アプリのルート（ログイン必須・詳細・設定等）は検索に出さない。/ と /about、docs のページは対象外。
# 実際の付与は functions/[[path]].ts（SPA フォールバックは常に "/" を取得し直すため、ここでは効かないことがある）
/login
  X-Robots-Tag: noindex
/settings/*
  X-Robots-Tag: noindex
/messages/*
  X-Robots-Tag: noindex
/e/*
  X-Robots-Tag: noindex
/p/*
  X-Robots-Tag: noindex
/t/*
  X-Robots-Tag: noindex
/share
  X-Robots-Tag: noindex
/open
  X-Robots-Tag: noindex
/404
  X-Robots-Tag: noindex

# Vite の出力はハッシュ付きファイル名が前提
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# 絵文字 API のグリフデータ（docs/emoji-maker.md §3.3）。中身を変えたらファイル名の版（*.v1.bin）を上げる
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
